# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION & PRODUCTION AUDIT EXAMPLE
# DriveSuccess Academy (Vahathi Motor Driving School)
# ==============================================================================

# 1. DATABASE CONFIGURATION (Supabase PostgreSQL / Prisma Pooler)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@aws-0-ap-south-1.supabase.com:5432/postgres"

# 2. JWT & AUTHENTICATION SECRETS
JWT_SECRET="your-256-bit-production-jwt-secret-key-change-this"

# 3. RAZORPAY PAYMENT GATEWAY CREDENTIALS
# Note: For Live production mode, use rzp_live_ keys from Razorpay Dashboard
RAZORPAY_KEY_ID="REDACTED_RAZORPAY_KEY"
RAZORPAY_KEY_SECRET="REDACTED_RAZORPAY_SECRET"
RAZORPAY_WEBHOOK_SECRET="your_production_webhook_secret_here"

# 4. FIREBASE AUTHENTICATION (CLIENT & SERVER)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy...your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="drivesuccess-academy.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="drivesuccess-academy"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="drivesuccess-academy.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abcdef123456"

# 5. PUBLIC SITE URL
NEXT_PUBLIC_SITE_URL="https://drivesuccess-next.vercel.app"

# 6. PRODUCTION LOGGING & MONITORING (SENTRY)
# NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
