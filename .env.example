# ==============================================================================
# DRIVESUCCESS ACADEMY - ENVIRONMENT VARIABLES & SECRETS CONFIGURATION TEMPLATE
# ==============================================================================

# 1. DATABASE CONNECTION (Prisma & PostgreSQL)
# Replace with production PostgreSQL connection string
DATABASE_URL="postgresql://postgres:your_secure_db_password@localhost:5432/drivesuccess_db?schema=public"

# 2. JWT SESSION & AUTHENTICATION SECRETS
# Minimum 32-character random string generated via `openssl rand -base64 32`
JWT_SECRET="drivesuccess_super_secret_jwt_key_2026_production_change_in_env"
NEXTAUTH_SECRET="drivesuccess_nextauth_secret_token_change_in_production"
NEXTAUTH_URL="https://drivesuccess-next.vercel.app"

# 3. RAZORPAY PAYMENT GATEWAY CREDENTIALS
RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_signature"

# 4. NEXT.JS PUBLIC ENVIRONMENT VARIABLES
# CRITICAL: NEXT_PUBLIC_APP_URL must be set to your STABLE production URL.
# This is used as the OAuth redirect_uri for Google Sign-In.
# DO NOT use a Vercel preview URL — it changes on every deployment and will
# cause Error 400: redirect_uri_mismatch after every new commit.
# Set this ONCE in Vercel → Settings → Environment Variables → Production.
# Add https://drivesuccess-next.vercel.app/auth/login to Google Cloud Console
# Authorized Redirect URIs — this is the ONLY entry you will ever need.
NEXT_PUBLIC_APP_URL="https://drivesuccess-next.vercel.app"

# Optional: Override the Google OAuth redirect URI on the server-side specifically.
# Only needed if your server-side domain differs from the client-side domain.
# If not set, NEXT_PUBLIC_APP_URL is used (recommended).
GOOGLE_REDIRECT_URI=""

NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"

# 5. FIREBASE AUTHENTICATION (OPTIONAL - REAL SMS PHONE AUTH)
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="drivesuccess-next.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="drivesuccess-next"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="drivesuccess-next.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_firebase_app_id"

# 6. MSG91 / TELECOM SMS GATEWAY (OPTIONAL - DLT REAL SMS)
MSG91_AUTH_KEY="your_msg91_auth_key"
MSG91_TEMPLATE_ID="your_msg91_dlt_template_id"

# 7. ADMIN DASHBOARD CREDENTIALS
ADMIN_EMAIL="admin@drivesuccess.edu"
ADMIN_PASSWORD="your_secure_admin_password_here"

# 8. VERCEL BLOB STORAGE (STUDENT PRIVATE DOCUMENTS)
BLOB_READ_WRITE_TOKEN=""

